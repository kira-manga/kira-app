+// Kira: constructed only after a successful lock; every following exit unlocks once.
+class ScopedBitmapUnlock {
+ public:
+  ScopedBitmapUnlock(JNIEnv* env, jobject bitmap) : env_(env), bitmap_(bitmap) {}
+  ScopedBitmapUnlock(const ScopedBitmapUnlock&) = delete;
+  ScopedBitmapUnlock& operator=(const ScopedBitmapUnlock&) = delete;
+  ~ScopedBitmapUnlock() { AndroidBitmap_unlockPixels(env_, bitmap_); }
+
+ private:
+  JNIEnv* const env_;
+  const jobject bitmap_;
+};
+
+// New bounded entrypoints reject invalid lengths and limit values before native parsing.
+const uint8_t* BoundedInput(JNIEnv* env, jobject encoded, jint length,
+                            jint max_pixels, jint max_dimension) {
+  if (encoded == nullptr || length <= 0 || max_pixels <= 0 ||
+      max_pixels > AVIF_DEFAULT_IMAGE_SIZE_LIMIT || max_dimension <= 0 ||
+      max_dimension > AVIF_DEFAULT_IMAGE_DIMENSION_LIMIT) {
+    return nullptr;
+  }
+  const jlong capacity = env->GetDirectBufferCapacity(encoded);
+  if (capacity < length) {
+    return nullptr;
+  }
+  return static_cast<const uint8_t*>(env->GetDirectBufferAddress(encoded));
+}
