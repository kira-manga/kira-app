+FUNC(jboolean, getInfoWithLimitsNative, jobject encoded, jint length,
+     jobject info, jint max_pixels, jint max_dimension) {
+  IGNORE_UNUSED_JNI_PARAMETERS;
+  const uint8_t* const buffer =
