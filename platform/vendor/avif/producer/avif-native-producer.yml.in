# Primary-admitted one-shot carrier: .github/workflows/avif-native-producer.yml
# Inert at this vendor path. The primary reviews the exact carrier SHA before its sole push.
name: Reviewed AVIF native candidate producer

on:
  push:
    branches: [remediation/app-native15-producer-20260914-01]

permissions:
  contents: read

concurrency:
  group: avif-native15-producer
  cancel-in-progress: false

jobs:
  candidate:
    if: ${{ github.event_name == 'push' && github.ref == 'refs/heads/remediation/app-native15-producer-20260914-01' && github.repository == 'kira-manga/kira-app' }}
    runs-on: ubuntu-22.04
    timeout-minutes: 45
    env:
      EXPECTED_RECIPE_COMMIT: ${{ github.sha }}
      KIRA_AVIF_PRODUCER_ADMITTED: native15-reviewed-source-only
      REPOSITORY_VISIBILITY: ${{ github.event.repository.visibility }}
      PYTHONDONTWRITEBYTECODE: '1'
      GIT_TERMINAL_PROMPT: '0'
    steps:
      - name: Require explicit resource admission and exact public recipe revision
        shell: bash
        run: |
          set -euo pipefail
          [[ "$KIRA_AVIF_PRODUCER_ADMITTED" == native15-reviewed-source-only ]]
          [[ "$EXPECTED_RECIPE_COMMIT" =~ ^[0-9a-f]{40}$ ]]
          [[ "$GITHUB_SHA" == "$EXPECTED_RECIPE_COMMIT" ]]
          [[ "$GITHUB_REF_TYPE" == branch && "$GITHUB_REF_NAME" == remediation/app-native15-producer-20260914-01 ]]
          [[ "$REPOSITORY_VISIBILITY" == public ]]
          [[ "$(df -Pk "$RUNNER_TEMP" | awk 'NR==2 {print $4}')" -ge 8388608 ]]
      - name: Checkout only the reviewed public producer inputs
        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          ref: ${{ github.sha }}
          fetch-depth: 1
          persist-credentials: false
          show-progress: false
          sparse-checkout-cone-mode: false
          sparse-checkout: |
            /platform/vendor/avif/
            /.github/workflows/avif-native-producer.yml
      - name: Set up the pinned JDK major (record actual patch version and hashes)
        uses: actions/setup-java@c5195efecf7bdfc987ee8bae7a71cb8b11521c00 # v4.7.1
        with:
          distribution: temurin
          java-version: '17'
      - name: Acquire only admitted hosted producer tools
        timeout-minutes: 12
        shell: bash
        run: bash platform/vendor/avif/producer/setup-hosted-tools.sh
      - name: Produce and inspect the four-ABI AAR candidate
        timeout-minutes: 31
        shell: bash
        run: timeout --kill-after=20s 30m bash platform/vendor/avif/producer/rebuild.sh
      - name: Upload only allowlisted candidate and public provenance (not qualification)
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: avif-native15-candidate-${{ github.run_id }}-${{ github.run_attempt }}
          if-no-files-found: error
          retention-days: 7
          compression-level: 0
          include-hidden-files: false
          path: |
            ${{ runner.temp }}/avif-native-result/avif-1.3.0.841110fd-kira-limits1.aar
            ${{ runner.temp }}/avif-native-result/provenance.json
            ${{ runner.temp }}/avif-native-result/artifact-report.json
            ${{ runner.temp }}/avif-native-result/source-preparation.json
            ${{ runner.temp }}/avif-native-result/source-manifest.json
            ${{ runner.temp }}/avif-native-result/limits.patch
            ${{ runner.temp }}/avif-native-result/native-build.init.gradle
            ${{ runner.temp }}/avif-native-result/SHA256SUMS
            ${{ runner.temp }}/avif-native-result/notices/*.txt
      - name: Final owned producer cleanup (also after failure or cancellation)
        if: ${{ always() }}
        id: owned_cleanup
        timeout-minutes: 2
        shell: bash
        env:
          PRE_CLEANUP_JOB_STATUS: ${{ job.status }}
        run: |
          set +e
          printf 'AVIF producer cleanup: STARTED (preceding job status: %s).\n' \
            "$PRE_CLEANUP_JOB_STATUS" >> "$GITHUB_STEP_SUMMARY"
          helper=platform/vendor/avif/producer/owned_resources.py
          if [[ -f "$helper" && ! -L "$helper" ]]; then
            /usr/bin/python3 "$helper" cleanup
            cleanup_status=$?
          else
            echo 'Cleanup unavailable: producer checkout/helper was not available; no paths guessed.'
            cleanup_status=1
          fi
          printf 'exit_status=%s\n' "$cleanup_status" >> "$GITHUB_OUTPUT"
          printf 'AVIF producer cleanup exit status: %s (preceding job status: %s).\n' \
            "$cleanup_status" "$PRE_CLEANUP_JOB_STATUS" >> "$GITHUB_STEP_SUMMARY"
          exit "$cleanup_status"
      - name: Retain only bounded producer logs and cleanup status (not qualification)
        if: ${{ always() }}
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: avif-native15-cleanup-${{ github.run_id }}-${{ github.run_attempt }}
          if-no-files-found: ignore
          retention-days: 7
          compression-level: 0
          include-hidden-files: false
          path: |
            ${{ runner.temp }}/avif-native-evidence-${{ github.run_id }}-${{ github.run_attempt }}/setup.log
            ${{ runner.temp }}/avif-native-evidence-${{ github.run_id }}-${{ github.run_attempt }}/rebuild.log
            ${{ runner.temp }}/avif-native-evidence-${{ github.run_id }}-${{ github.run_attempt }}/gradle-stop-after-batch.log
            ${{ runner.temp }}/avif-native-evidence-${{ github.run_id }}-${{ github.run_attempt }}/gradle-stop-final.log
            ${{ runner.temp }}/avif-native-evidence-${{ github.run_id }}-${{ github.run_attempt }}/cleanup-status.txt
            ${{ runner.temp }}/avif-native-evidence-${{ github.run_id }}-${{ github.run_attempt }}/native-log-index.txt
            ${{ runner.temp }}/avif-native-evidence-${{ github.run_id }}-${{ github.run_attempt }}/native-logs/*.log
