<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Store-only APNs: Release/TestFlight/App Store expand APS_ENVIRONMENT to production.
         Ordinary Debug uses the empty iosApp-nopush.entitlements instead. -->
    <key>aps-environment</key>
    <string>$(APS_ENVIRONMENT)</string>
    <key>com.apple.developer.associated-domains</key>
    <array>
        <string>applinks:kiramanga.me</string>
    </array>
</dict>
</plist>
