<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- APNs environment for remote push. Driven by the per-config APS_ENVIRONMENT build setting
         (project.yml): `development` in Debug, `production` in Release/TestFlight/App Store — so the
         same entitlements file works for both without hand-editing. Requires the App ID to have the
         Push Notifications capability enabled (owner step in the Apple Developer portal). -->
    <key>aps-environment</key>
    <string>$(APS_ENVIRONMENT)</string>
    <key>com.apple.developer.associated-domains</key>
    <array>
        <string>applinks:kiramanga.me</string>
    </array>
</dict>
</plist>
