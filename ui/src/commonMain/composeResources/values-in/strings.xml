<?xml version="1.0" encoding="utf-8"?>
<!--
  Indonesian (values-in) values for the Kira :ui string catalog (P0-LOC localization recovery).

  Created so the live :ui screens resolve in for the Indonesian locale instead of falling back to
  English. Compose-resources resolves strings against the package that owns the Res symbol, so
  the full catalogs that already shipped under composeApp/.../values-in were unreachable from
  :ui screens; this file ports the translations for the keys the :ui module defines.

  Values are reused verbatim (no machine translation) from
  composeApp/src/commonMain/composeResources/values-in/strings.xml, matched by identical key name
  against the :ui default catalog (ui/.../values/). Keys with no translation available in the
  composeApp or native in catalogs are intentionally omitted and fall back to the English
  values/ default automatically.
-->
