# Kira Android Internal Testing configuration template.
#
# Copy this shape to .secrets/android-release.env and fill it locally. The real file is ignored,
# must be chmod 600, and must never be committed, uploaded, or printed. Prefer *_FILE entries for
# binary, JSON, password, and private-key material so those values never need to appear inline.

# ── Android Play upload key ─────────────────────────────────────────────────────────────────────
# Create/retrieve only the Play upload key documented in docs/release/ANDROID_INTERNAL_TESTING.md.
# The keystore is PKCS12/JKS; the alias and both passwords come from the keytool ceremony.
ANDROID_KEYSTORE_BASE64=
ANDROID_KEYSTORE_FILE=/absolute/path/to/kira-upload.jks
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEYSTORE_PASSWORD_FILE=/absolute/path/to/kira-upload-keystore-password.txt
ANDROID_KEY_ALIAS=
ANDROID_KEY_ALIAS_FILE=/absolute/path/to/kira-upload-alias.txt
ANDROID_KEY_PASSWORD=
ANDROID_KEY_PASSWORD_FILE=/absolute/path/to/kira-upload-key-password.txt

# ── Firebase ────────────────────────────────────────────────────────────────────────────────────
# Download the real file from Firebase Console → Project settings → Your apps → Android app.
# GOOGLE_SERVICES_JSON is the one-line Base64 form expected by the GitHub workflow.
GOOGLE_SERVICES_JSON=
GOOGLE_SERVICES_JSON_FILE=/absolute/path/to/google-services.json

# ── Google Play API ──────────────────────────────────────────────────────────────────────────────
# Create a Play-only Google Cloud service-account JSON key and grant it app-only testing access in
# Play Console. The workflow passes this JSON to Fastlane's upload_to_play_store lane.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_FILE=/absolute/path/to/google-play-service-account.json

# ── Public app source-config authority ──────────────────────────────────────────────────────────
# The app appends /api/v1/source-config/document. Keep this as the HTTPS origin only.
KIRA_SOURCE_CONFIG_BASE_URL=https://api.kiramanga.me

# Comma-separated key-id=Base64-X.509 Ed25519 public key entries. This is public trust material,
# derived from the backend signing ceremony; never invent a key or paste the private key here.
KIRA_SOURCE_CONFIG_PINNED_KEYS=

# ── Backend source-document signing ─────────────────────────────────────────────────────────────
# SOURCE_CONFIG_KEY_ID is the active id (for example prod-2026-01) and must match the backend's
# KIRA_SIGNING_ACTIVE_KEY_ID and KIRA_SIGNING_VERIFICATION_KEYS_0_KEY_ID.
SOURCE_CONFIG_KEY_ID=
SOURCE_CONFIG_PRIVATE_KEY_FILE=/absolute/path/to/prod-2026-01.private.b64
SOURCE_CONFIG_PUBLIC_KEY_FILE=/absolute/path/to/prod-2026-01.public.b64

# Backend deployment values. The private value is secret-manager-only; the public value is also
# used to form KIRA_SOURCE_CONFIG_PINNED_KEYS. These are resolved from the files above by the
# helper scripts and are not needed in the Android workflow itself.
KIRA_SIGNING_ACTIVE_KEY_ID=
KIRA_SIGNING_PRIVATE_KEY=
KIRA_SIGNING_PRIVATE_KEY_FILE=/absolute/path/to/prod-2026-01.private.b64
KIRA_SIGNING_VERIFICATION_KEYS_0_KEY_ID=
KIRA_SIGNING_VERIFICATION_KEYS_0_PUBLIC_KEY=
KIRA_SIGNING_VERIFICATION_KEYS_0_PUBLIC_KEY_FILE=/absolute/path/to/prod-2026-01.public.b64

# The exact canonical JSON document to import/publish is normally the backend fixture:
# kira-backend/src/test/resources/fixtures/bundled-full.json. Importing it creates one signed
# snapshot; the backend allocates revision/timestamp/checksum and signs the exact canonical bytes.
# Do not invent SOURCE_CONFIG_DOCUMENT_REVISION, SOURCE_CONFIG_DOCUMENT_CHECKSUM, or a timestamp:
# those snapshot values are generated by the backend publication transaction.
SOURCE_CONFIG_DOCUMENT_FILE=/absolute/path/to/kira-backend/src/test/resources/fixtures/bundled-full.json

# Used only by the explicitly requested --publish-source-config apply step. Keep the password in a
# chmod-600 file when possible. These credentials are never sent to GitHub.
SOURCE_CONFIG_ADMIN_EMAIL=
SOURCE_CONFIG_ADMIN_EMAIL_FILE=/absolute/path/to/source-config-admin-email.txt
SOURCE_CONFIG_ADMIN_PASSWORD=
SOURCE_CONFIG_ADMIN_PASSWORD_FILE=/absolute/path/to/source-config-admin-password.txt

# Optional repository variable used to keep Android version codes above any existing upload.
ANDROID_BUILD_NUMBER_OFFSET=1000
